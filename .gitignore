# Ignore node_modules in all directories
**/node_modules/

# Build folders
**/dist/
**/build/
**/.parcel-cache/
**/.next/
**/.turbo/

# Environment files
.env
.env.*  # Includes .env.local, .env.production, etc.
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE settings
.vscode/
.idea/

# OS-specific
.DS_Store
Thumbs.db

# Cache, temp, and backups
*.tmp
*.temp
*.bak
*.swp

# React/Vite/Parcel specific
**/.cache/
**/coverage/
**/react-scripts/

# TypeScript build info (if used)
*.tsbuildinfo

# Ignore lock files if you don’t want them (optional)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
